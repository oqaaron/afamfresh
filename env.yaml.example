# =============================================================
# AfamFresh - template for env.yaml
# =============================================================
# Copy to env.yaml and fill in real values:
#
#     cp env.yaml.example env.yaml
#     chmod 640 env.yaml
#
# ⚠️ PHP reads this as the WEB SERVER's user (daemon under XAMPP,
# www-data on most Linux servers) — not as you. chmod 600 owned by
# your login account locks the server out: every credential silently
# resolves to empty and Pesapal/Brevo/Twilio just stop working with
# no error on the page. Give the server's group read access:
#
#     sudo chown youruser:daemon env.yaml && chmod 640 env.yaml
#
# This template is safe to commit. env.yaml is not, and is denied
# by the .htaccess beside it.
# =============================================================

# --- Database ------------------------------------------------
DB_HOST: localhost
DB_USER: root
DB_PASS: ""
DB_NAME: kitchen
# Cloud SQL only — when this socket path exists the app connects
# through it instead of DB_HOST.
# DB_SOCKET: /cloudsql/PROJECT:REGION:INSTANCE

# --- Pesapal -------------------------------------------------
# 'live' charges real money. Use 'sandbox' for testing.
PESAPAL_ENV: sandbox
PESAPAL_CONSUMER_KEY: ""
PESAPAL_CONSUMER_SECRET: ""
PESAPAL_SANDBOX_CONSUMER_KEY: ""
PESAPAL_SANDBOX_CONSUMER_SECRET: ""
PESAPAL_IPN_ID: ""
PESAPAL_SANDBOX_IPN_ID: ""
PESAPAL_PUBLIC_BASE_URL: https://your-public-host

# --- Email (Brevo) -------------------------------------------
BREVO_API_KEY: ""

# The "from" address. Defaults to noreply@techaus.online, which is verified on
# the Brevo account with DKIM and DMARC. Only change this to another address
# verified on that account -- an unverified sender is accepted by the API and
# then rejected or spam-filed by the receiver, which reports as a successful
# send. Sending as an @gmail.com address fails DMARC alignment for the same
# reason and should not be used.
BREVO_FROM_EMAIL: ""
BREVO_FROM_NAME: ""

# Alphanumeric SMS sender name, max 11 characters, e.g. AfamFresh.
# Leave empty to disable SMS entirely -- an unregistered sender is accepted by
# the API and then never delivered, so sending nothing beats sending into a
# void. SMS credits are billed separately from email on the same API key.
BREVO_SMS_SENDER: ""
SMTP_PASSWORD: ""

# --- SMS (Twilio) --------------------------------------------
TWILIO_ACCOUNT_SID: ""
TWILIO_AUTH_TOKEN: ""

# --- Firebase (push notifications) ---------------------------
# Locally: leave FIREBASE_CREDENTIALS_JSON empty and drop the service
# account key at storage/firebase/*.json, outside the web root.
# On Cloud Run: there is no persistent disk, so paste the whole service
# account JSON into FIREBASE_CREDENTIALS_JSON (via Secret Manager).
# With neither set, push notifications are disabled and say so in the log.
FIREBASE_PROJECT_ID: afamfresh-f68c6
FIREBASE_CREDENTIALS_JSON: ""

# --- Uploaded files (product images, avatars, delivery proof) -
# Empty: files are written to uploads/ on local disk, as in development.
# Set: they go to this Google Cloud Storage bucket instead.
#
# This MUST be set on Cloud Run. That filesystem is ephemeral and per
# instance, so an upload written there is invisible to every other
# container and is destroyed on the next deploy.
#
# The bucket needs public read (objects are served directly to the app):
#   gcloud storage buckets add-iam-policy-binding gs://BUCKET \
#     --member=allUsers --role=roles/storage.objectViewer
GCS_BUCKET: ""

# --- Google Sign-In ------------------------------------------
# The WEB client id (not an Android one) that the app passes to
# requestIdToken in AuthRepository.kt. The backend rejects any token whose
# audience does not match, so if these two ever disagree, sign-in fails with
# "Invalid token audience" and nothing else explains why.
GOOGLE_WEB_CLIENT_ID: ""

# --- Database over TCP (Render, a VPS — anything outside Google) ----
# Cloud Run uses DB_SOCKET and ignores all three of these.
#
# DB_SSL_CA is the Cloud SQL *server* CA, pasted as PEM rather than a path:
# these platforms inject config as environment variables and have no
# persistent disk. Download it from the instance's Connections -> Security
# page. Without it the database password and every row cross the public
# internet in clear text.
DB_PORT: 3306
DB_SSL_CA: ""
