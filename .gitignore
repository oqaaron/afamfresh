# Real credentials — DB, Pesapal, SMTP, Firebase.
# env.yaml.example is tracked and documents the required keys.
env.yaml

# User-uploaded content. The folders themselves are tracked (via .gitkeep) so a
# fresh deploy has somewhere to write, and uploads/.htaccess is real config —
# but nothing anyone uploaded belongs in git.
uploads/**
!uploads/**/
!uploads/.htaccess
!uploads/*/.gitkeep

# Firebase service account / any stray key material
*.json.key
service-account*.json
*.pem
*.p12
*.key

# Logs and local scratch
*.log
error_log
php_errors.log
*.bak
*.orig
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Firebase / Google service account private keys. The backend reads one from
# storage/firebase/service-account.json locally and from Secret Manager on
# Cloud Run -- neither belongs in git. Matched by pattern as well as path,
# because the console downloads them under a generated name.
storage/
*adminsdk*.json
*-firebase-adminsdk-*.json
