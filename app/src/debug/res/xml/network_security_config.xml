<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG configuration. Overrides the release file of the same name.

  Cleartext is permitted ONLY to the specific hosts used for local
  development, not globally — so a debug build still cannot silently talk
  http:// to a production or third-party host.

  If your dev machine's LAN address changes, add it here. Note that
  192.168.1.145 is how the Android emulator reaches the host machine.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- This dev machine, running XAMPP.

             This address keeps moving: 192.168.11.67 -> 192.168.1.9 ->
             192.168.3.56 -> 192.168.3.135 -> 192.168.1.9 -> 10.34.213.45 ->
             192.168.1.9 -> 192.168.1.12. Old entries are removed rather than
             kept, since a stale entry grants cleartext to whatever host now
             holds that lease.

             Changing this alone is not enough: base.url.debug in
             local.properties has to match AND the app must be rebuilt, because
             the URL is compiled into BuildConfig. -->
        <domain includeSubdomains="false">192.168.1.12</domain>

        <!-- How the Android emulator reaches the host machine. -->
        <domain includeSubdomains="false">192.168.1.145</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
