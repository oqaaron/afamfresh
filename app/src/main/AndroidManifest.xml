<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============= PERMISSIONS ============= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ACCESS_FINE_LOCATION/ACCESS_COARSE_LOCATION moved to
         src/rider/AndroidManifest.xml: only the rider flavor calls a device
         location API (RiderLocationUpdates.kt etc). Customer and vendor map
         screens are tap-to-pick-a-point only, so declaring location here
         requested a permission those two flavors never use — a Play Data
         Safety mismatch. -->
    <!-- ACCESS_BACKGROUND_LOCATION removed: it was declared but never
         requested, and a Play policy flag on all three apps for it. The rider
         flavor's foreground tracking service gives continuous location while
         a delivery is active without needing it. -->
    <!-- WRITE_EXTERNAL_STORAGE/READ_EXTERNAL_STORAGE removed: image pickers
         (NewProductScreen, ConfirmReceiptScreen, ProfileScreen,
         RiderDeliveryDetailScreen) all use the modern Photo Picker
         (PickVisualMedia), which needs neither permission. Nothing in the
         codebase references either constant. -->
    <!-- Required on API 33+ for any posted notification, including FCM's.
         MainActivity and AfamFreshMessagingService already request/handle
         this at runtime; without the manifest declaration that request was
         silently ungrantable. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AfamFresh"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- The osmdroid.offline.directory meta-data was removed along with the
             osmdroid dependencies: nothing in the app used them, and the value
             pointed at a hardcoded /sdcard/ path that scoped storage makes
             unwritable from Android 10 onwards anyway. Maps are Google Maps
             Compose. -->

        <!-- The SignInOptions meta-data pointing at @string/default_web_client_id
             was removed. That string is generated by the Google Services plugin
             only when google-services.json contains an oauth_client entry, and
             the current file has none for any of the three apps — so the build
             failed on a missing resource.

             Nothing was lost: Google Sign-In is configured in code, and
             AuthRepository.kt:544 passes the web client id to requestIdToken()
             directly rather than reading this string. The meta-data was
             vestigial. -->

        <!-- NOTE: Google Sign-In still needs each app's SHA-1 registered
             against its package in the Firebase console. Without that, sign-in
             fails at runtime with APIException 10 (DEVELOPER_ERROR) even though
             the build succeeds and push notifications work. -->

        <!-- Substituted at build time from local.properties via
             manifestPlaceholders, so the key is not in version control. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- ============= MAIN ACTIVITY ============= -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AfamFresh.Splash">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for Password Reset: custom-scheme fallback.
                 Kept for devices/mail clients that don't route the https
                 App Link below into the app (verification not yet
                 propagated, App Links disabled by the user, etc) and for
                 local/debug testing where the backend can't host a
                 verifiable assetlinks.json at all. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Scheme comes from the flavor. All three apps registering
                     "afamfresh" would make Android show an app-chooser every
                     time someone tapped a password-reset link. -->
                <data
                    android:scheme="${deepLinkScheme}"
                    android:host="reset-password" />
            </intent-filter>

            <!-- Deep link for Password Reset: verified Android App Link.
                 android:autoVerify="true" makes Android check, at install
                 time, that ${appLinkHost}/.well-known/assetlinks.json (see
                 api/.well-known/assetlinks.json) lists this app's package +
                 signing certificate for this exact host. Once verified, a
                 tap on this URL opens this app directly, with no browser hop,
                 no chooser, and critically, no other app can claim it: the
                 custom scheme above could be registered by any app on the
                 device, but this cannot be forged without the real signing
                 key. The path is per-flavor (see api/.htaccess's
                 go slash SCHEME slash reset-password rewrite) so the three
                 flavors don't collide into a chooser between themselves either. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${appLinkHost}"
                    android:pathPrefix="/go/${deepLinkScheme}/reset-password" />
            </intent-filter>

        </activity>

        <!-- ============= PUSH NOTIFICATIONS ============= -->
        <!-- Receives FCM messages. Without this registered, data-payload
             pushes are dropped and never reach the app. -->
        <service
            android:name=".services.AfamFreshMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="afamfresh_orders" />

    </application>

</manifest>