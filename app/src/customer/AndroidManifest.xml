<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Customer app needs location permissions for GPS-based address selection
         (LocationViewModel, LocationPickerScreen). Unlike the rider flavor, we
         don't need foreground service permissions since we're not running a
         background location service — just one-shot GPS detection. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

</manifest>
